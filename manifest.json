{
  "manifest_version": 3,
  "name": "DevOps Finder",
  "version": "1.2.1",
  "description": "Find and open Git and TFVC repositories in Azure DevOps.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://devops.ageas.pt/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "DevOps Finder",
    "default_icon": {
      "16": "images/devops-finder-16.png",
      "24": "images/devops-finder-24.png",
      "32": "images/devops-finder-32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "images/devops-finder-16.png",
    "32": "images/devops-finder-32.png",
    "48": "images/devops-finder-48.png",
    "128": "images/devops-finder-128.png"
  }
}
